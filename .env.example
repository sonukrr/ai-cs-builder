# Template only — copy to .env.local and fill in there.
# NEVER put real values in this file: .env.local is gitignored, this file is not.

# ---- Agent ----------------------------------------------------------------
# Required. The orchestrator runs on Claude Opus 5.
ANTHROPIC_API_KEY=

# Only needed when the key is not scoped to a single workspace. An unscoped key
# returns "this request must include the anthropic-workspace-id header".
# Find the id in the Console URL: console.anthropic.com/settings/workspaces/<id>
ANTHROPIC_WORKSPACE_ID=

# Office/team key path: routes agent calls through the internal Astra wrapper
# service (see src/app/api/astra-proxy) instead of api.anthropic.com directly.
# The secret key is issued alongside the office Anthropic access; sent to
# Astra as `secretKey: <value>#HACKATHON_ANTHROPIC_OPUS_4.6`.
ASTRA_SECRET_KEY=

# Only needed when the app's own base URL is not http://localhost:3000 — the
# Astra proxy client (anthropicOffice() in src/lib/agent/client.ts) calls this
# app's own /api/astra-proxy route and needs an absolute origin to do it from
# server-side code.
APP_BASE_URL=

# ---- Figma (primary entry point) ------------------------------------------
# Which backend the Figma provider uses: mcp | rest | mock
# mock works with zero credentials and is what the demo falls back to.
FIGMA_PROVIDER=mock

# `mcp`: either of Figma's two MCP servers.
#   Desktop  - open the Figma desktop app, Preferences -> Enable Dev Mode MCP
#              Server, and leave the default below. Needs no credentials.
#   Hosted   - set FIGMA_MCP_URL=https://mcp.figma.com/mcp. No desktop app, so
#              this is the one that works headless. It needs an OAuth token:
#              Figma's hosted server rejects `figd_` personal access tokens and
#              its public client registration is closed, so the token has to
#              come from an interactive login. Run `claude`, connect the figma
#              server with /mcp once, and the studio reuses the token cached in
#              ~/.claude/.credentials.json, refreshing it as needed.
FIGMA_MCP_URL=http://127.0.0.1:3845/mcp

# Optional: an OAuth bearer token for the hosted server, if you would rather
# supply it yourself than have the studio read Claude Code's cache. This is NOT
# a figd_ personal access token — the hosted MCP server refuses those.
FIGMA_MCP_TOKEN=

# Optional: where Claude Code's credential cache lives, if not the default
# ~/.claude/.credentials.json.
CLAUDE_CREDENTIALS_PATH=

# `rest`: a Figma personal access token (Settings -> Security -> Personal access
# tokens). These begin with `figd_`. Works headless / in CI, unlike the desktop
# MCP server.
FIGMA_TOKEN=

# ---- GitHub ----------------------------------------------------------------
# One knob for both halves of the GitHub integration: reading the approved base
# career site, and pushing a generated site to a destination repository.
#   mcp  — GitHub's MCP server (GITHUB_MCP_URL below). Still uses the token for
#          the two things MCP has no tool for: writing an image, and listing a
#          repository recursively.
#   rest — the GitHub API directly.
#   mock — stand-in base repository, and a publish that pushes nothing.
GITHUB_PROVIDER=mock

# owner/name or a GitHub URL. The approved base career site, which the studio
# reads and branches but never pushes a generated site over.
BASE_SITE_REPO=
# Needs contents: read/write on the repositories above, plus repository
# creation if the studio is to create a destination repository.
GITHUB_TOKEN=

# ---- Publishing: GitHub destination + Vercel -------------------------------
# The repository a generated site is pushed to is NOT set here: an
# administrator supplies it per project in the publish panel, and it is stored
# on the project. These settings are only about how the push happens.
#
# Set this only to make publishing use a different backend from GITHUB_PROVIDER
# above. Blank means the same one.
GITHUB_DEPLOY_PROVIDER=
# Defaults to https://api.githubcopilot.com/mcp/ when the backend is `mcp`.
# Setting this alone is enough to select the MCP backend.
GITHUB_MCP_URL=
# A GitHub PAT. Falls back to GITHUB_TOKEN when unset.
#
# The alternative is the OAuth token Claude Code caches — the studio reads it
# the same way the Figma MCP backend does. That needs a pre-registered OAuth
# app: GitHub's authorization server does not support dynamic client
# registration, so `claude mcp add` cannot register one for you and /mcp alone
# will not authorise this server. Pass --client-id if you have an OAuth app;
# otherwise a token here is the shorter road.
GITHUB_MCP_TOKEN=

# Vercel. Without a token the site is still generated and pushed; the publish
# then says to import the repository once at https://vercel.com/new, after
# which Vercel builds every push on its own.
VERCEL_TOKEN=
# Only for a team account — find it at vercel.com/<team>/~/settings.
VERCEL_TEAM_ID=

# ---- Research (job data and inspiration) -----------------------------------
# Master switch. `false` takes the studio entirely off the open web.
ENABLE_RESEARCH=true

# Tavily (app.tavily.com) — keys begin with `tvly-`. With a key the agent
# searches and reads careers pages itself, so the roles it loads into the
# preview can name the page they came from. Without one it falls back to
# Anthropic's built-in web search, which answers inside the model's turn and
# hands no page back, so researched jobs rest on recollection instead.
TAVILY_API_KEY=

# ---- Design fidelity review ------------------------------------------------
# After a Figma import the studio stays closed until an administrator approves
# a comparison of the design against what was actually built. Coverage, order
# and tokens are checked exactly and need nothing here. These two only add the
# visual evidence — the two screenshots shown side by side.
#
# A browser to screenshot the preview with. Chrome is driven directly; no
# browser is downloaded at install time.
CHROME_PATH=/usr/bin/google-chrome
# Where the preview host fetches the blueprint from while being screenshotted.
STUDIO_ORIGIN=http://localhost:3000

# ---- Imagery ---------------------------------------------------------------
# Company uploads and branded placeholders work with no keys at all. A key here
# only adds stock photography search. Set one, not both — Unsplash wins.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ---- Live preview ----------------------------------------------------------
# The Angular host that renders the blueprint with the real zm-careers-lib
# components. Run it with `npm run preview`.
PREVIEW_ORIGIN=http://localhost:4200

# Which data source the preview opens on: mock | live.
# `mock` runs the real components against fixtures and needs no credentials.
#
# The careers-API identity for live mode is not configured here: the preview
# host carries it, in preview-app/src/app/preview-config.ts. `zm-careers-lib`
# reads it out of browser storage before Angular bootstraps, so passing it
# through the studio only added a way to get it wrong.
PREVIEW_SOURCE=mock
